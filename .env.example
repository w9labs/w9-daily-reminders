# GitHub Container Registry username/organization
GITHUB_USER=your-username

# W9 Daily Reminders Configuration
W9_REMINDERS_PORT=8787
W9_REMINDERS_FRONTEND_PORT=8083
W9_REMINDERS_MAIL_SERVICE_TOKEN=your-service-token
W9_REMINDERS_TURNSTILE_SITE_KEY=your-site-key
W9_REMINDERS_TURNSTILE_SECRET=your-secret
W9_REMINDERS_RUST_LOG=w9_daily_reminders=info,axum=info

# W9 Mail API (used for authentication and email delivery)
W9_MAIL_API_BASE=https://w9.nu/api

# Google OAuth (for Google Calendar integration)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://reminder.w9.nu/google/callback

# Cerebras AI (for email content generation)
CEREBRAS_API_KEY=sk-your-cerebras-key

# Pollinations AI (for image generation)
POLLINATIONS_API_KEY=your-pollinations-key
POLLINATIONS_API_BASE=https://enter.pollinations.ai

# Cloudflare AI (for image generation)
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token
CLOUDFLARE_AI_BASE=https://api.cloudflare.com/client/v4
