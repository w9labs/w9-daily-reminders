# W9 Daily Reminders - Environment Variables

# Server
PORT=8084
RUST_LOG=w9_daily_reminders=info,axum=info

# PostgreSQL Database
DATABASE_URL=postgres://w9_admin:password@w9-postgres:5432/w9_reminders

# W9 Mail API (email delivery)
W9_MAIL_API_BASE=https://mail.w9.nu/api

# Google OAuth (Calendar + Tasks)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://reminder.w9.nu/google/callback

# AI Providers (at least one required)
CEREBRAS_API_KEY=sk-your-cerebras-key
NVIDIA_API_KEY=nvapi-your-nvidia-key

# Image Generation (at least one required)
POLLINATIONS_API_KEY=your-pollinations-key
POLLINATIONS_API_BASE=https://enter.pollinations.ai
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_API_TOKEN=your-api-token
CLOUDFLARE_AI_BASE=https://api.cloudflare.com/client/v4
